rust_binary {
    name: "vendor.lineage.touch-service.a6010",
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.touch-service.a6010.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.a6010.xml"],
    vendor: true,
    rustlibs: [
        "libbinder_rs",
        "liblog_rust",
        "liblogger",
        "vendor.lineage.touch-V1-rust",
    ],
    srcs: [
        "keydisabler_hal.rs",
        "main.rs",
    ],
    crate_root: "main.rs",
}
